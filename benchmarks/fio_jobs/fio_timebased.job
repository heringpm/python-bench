[fiojob]
direct=${DIRECTIO}
ioengine=${IOENGINE}
rw=${READWRITE}
rwmixread=${RWMIXREAD}
blocksize=${BLOCKSIZE}
iodepth=${IODEPTH}
filesize=${FILESIZE}
runtime=${RUNTIME}
time_based
numjobs=${NUMJOBS}
group_reporting
norandommap=0
fallocate=none
filename_format=fio.$jobnum.$filenum
directory=${DIRECTORY}
