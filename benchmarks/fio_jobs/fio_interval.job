[fiojob]
direct=${DIRECTIO}
ioengine=${IOENGINE}
rw=${READWRITE}
rwmixread=${RWMIXREAD}
blocksize=${BLOCKSIZE}
iodepth=${IODEPTH}
filesize=${FILESIZE}
numjobs=${NUMJOBS}
group_reporting
norandommap=0
fallocate=none
filename_format=fio.$jobnum.$filenum
directory=${DIRECTORY}
write_bw_log=${LOGPREFIX}
write_iops_log=${LOGPREFIX}
log_avg_msec=${LOG_AVG_MSEC}
${EXTRA_ARGS}
