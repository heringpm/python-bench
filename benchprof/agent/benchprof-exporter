#!/usr/bin/env python3
"""benchprof-exporter - lightweight Prometheus /metrics HTTP endpoint for
one benchprof client node, started by benchprof-agent when `start
--export-port PORT` is given.

Why this exists: benchprof's normal path (sar/pidstat/links/lctl write
local files that only get parsed into panels by `benchprof report` after
the whole run finishes and files are rsynced back) is fine for a
post-run report, but gives you nothing to look at *while* a long run is
in progress. This exposes a handful of live gauges instead:

  - benchprof_cpu_percent{node,mode}        from /proc/stat deltas
  - benchprof_mem_percent{node}             from /proc/meminfo
  - benchprof_process_cpu_percent{node,command}  latest pidstat process row
  - benchprof_net_link_gbps{node,device,port,direction}  from links.csv
  - benchprof_crypto_cpu_percent{node,kind}  from perf sample classification
    (kind="ssk" for Lustre GSS SSK RPC encryption, kind="fscrypt" for
    filesystem-level encryption) - see poll_crypto() below.

CPU/Mem are read straight from /proc rather than via sadc/sadf, so this
has no dependency on sysstat being installed (unlike the sar.py path) -
every quirk chased down there (missing sadc, %sys vs %system, combined
rows, disambiguation suffixes) simply doesn't apply here.

Stdlib only (http.server + threading) - no pip/package install required
on client nodes, matching benchprof-agent's dependency-free design.
"""
import argparse
import http.server
import os
import re
import shutil
import socketserver
import subprocess
import sys
import tempfile
import threading
import time
from pathlib import Path

POLL_S = 1.0
_BYTES_PER_UNIT = {"ib": 4, "roce": 1}

# Separate, coarser cadence for the encryption-CPU sampler (see poll_crypto
# below) - it works by actually running `perf record` for a slice of every
# tick, which has real CPU/overhead cost unlike the /proc-based pollers, so
# it ticks less often and only samples for part of its own interval.
CRYPTO_POLL_S = 2.0
CRYPTO_SAMPLE_S = 1

# SSK (Lustre's GSS "shared secret key" mechanism) and fscrypt don't run as
# separate processes/threads - SSK encrypts/decrypts RPCs inline inside
# existing Lustre threads (ptlrpcd, ll_ost*, ...) and fscrypt encrypts
# inline in whichever task issued the I/O syscall - so pidstat-based
# per-process CPU (poll_pidstat above) can't isolate either one; the only
# place that information exists is in call stacks. This takes a short
# `perf record -g` sample each tick and classifies samples by symbol:
# stacks containing SSK-specific symbols (or generic crypto symbols inside
# a Lustre client thread) count as "ssk"; stacks containing fscrypt-specific
# symbols (or generic crypto symbols elsewhere) count as "fscrypt". Since
# cpu-clock sampling is uniform across CPU time, the fraction of samples
# matched is directly an estimate of %CPU spent in that category.
_LUSTRE_PROCESS_PREFIXES = (
    "ptlrpcd", "ll_ost", "ll_sa", "ll_cfg", "ll_agl", "ldlm_bl", "ldlm_cb",
    "ldlm_cn", "osc_", "mdc_", "lov_", "lnet", "lquota", "kiblnd", "o2iblnd",
    "ll_imp_inval", "jbd2",
)
_SSK_SYMBOL_RE = re.compile(r"gss_sk|sptlrpc|bulk_sec_desc", re.IGNORECASE)
_FSCRYPT_SYMBOL_RE = re.compile(r"fscrypt", re.IGNORECASE)
_GENERIC_CRYPTO_RE = re.compile(
    r"aesni|aes_|_xts|\bxts_|\bgcm|\bccm|crypto_skcipher|crypto_shash|crypto_cipher",
    re.IGNORECASE,
)


def _is_lustre_proc(command: str) -> bool:
    c = command.lower()
    return any(c.startswith(p) for p in _LUSTRE_PROCESS_PREFIXES)


class Collector:
    def __init__(self, host: str, rundir: Path):
        self.host = host
        self.rundir = rundir
        self.lock = threading.Lock()
        self.cpu_pct = {}
        self.mem_pct = None
        self.process_cpu = {}
        self.link_gbps = {}
        self.crypto_pct = {}  # kind ("ssk"/"fscrypt") -> %CPU estimate
        self._prev_stat = None
        self._prev_links = {}  # (device,port,direction) -> (epoch, bytes)
        self._perf_path = shutil.which("perf")
        self._perf_warned = False

    def poll_cpu(self):
        try:
            with open("/proc/stat") as f:
                line = f.readline()
        except OSError:
            return
        parts = line.split()
        if len(parts) < 8 or parts[0] != "cpu":
            return
        vals = [int(x) for x in parts[1:8]]  # user nice system idle iowait irq softirq
        names = ["user", "nice", "system", "idle", "iowait", "irq", "softirq"]
        if self._prev_stat is not None:
            deltas = [v - p for v, p in zip(vals, self._prev_stat)]
            total = sum(deltas)
            if total > 0:
                with self.lock:
                    self.cpu_pct = {n: 100.0 * d / total for n, d in zip(names, deltas)}
        self._prev_stat = vals

    def poll_mem(self):
        meminfo = {}
        try:
            with open("/proc/meminfo") as f:
                for line in f:
                    k, _, v = line.partition(":")
                    try:
                        meminfo[k.strip()] = float(v.strip().split()[0])
                    except (ValueError, IndexError):
                        continue
        except OSError:
            return
        total = meminfo.get("MemTotal")
        avail = meminfo.get("MemAvailable")
        if total and avail is not None and total > 0:
            with self.lock:
                self.mem_pct = 100.0 * (total - avail) / total

    def poll_pidstat(self):
        # Same header/row layout as parsers/pidstat.py, inlined here since
        # client nodes don't have the benchprof python package installed -
        # only process-level rows (TID == "-") are kept, re-read whole file
        # each tick (pidstat.log is small for a benchmark run's duration).
        path = self.rundir / f"pidstat.{self.host}.log"
        if not path.is_file():
            return
        header = []
        latest_time = None
        latest = {}
        try:
            with open(path) as f:
                for raw in f:
                    line = raw.rstrip("\n")
                    if not line or line.startswith("Linux") or line.startswith("Average"):
                        continue
                    if line.lstrip().startswith("#"):
                        header = line.lstrip("#").split()
                        continue
                    if not header:
                        continue
                    parts = line.split()
                    if len(parts) < len(header):
                        continue
                    fixed = parts[:len(header) - 1]
                    command = " ".join(parts[len(header) - 1:])
                    d = dict(zip(header[:-1], fixed))
                    d[header[-1]] = command
                    if d.get("TID", "-") != "-":
                        continue
                    t = d.get("Time", "")
                    try:
                        cpu = float(d.get("%CPU", ""))
                    except ValueError:
                        continue
                    if t != latest_time:
                        latest_time = t
                        latest = {}
                    latest[d.get("Command", "?")] = cpu
        except OSError:
            return
        if latest:
            with self.lock:
                self.process_cpu = latest

    def poll_links(self):
        path = self.rundir / f"links.{self.host}.csv"
        if not path.is_file():
            return
        latest_by_key = {}
        try:
            with open(path) as f:
                header_line = f.readline()
                cols = [c.strip() for c in header_line.strip().split(",")]
                for line in f:
                    vals = line.strip().split(",")
                    if len(vals) != len(cols):
                        continue
                    d = dict(zip(cols, vals))
                    try:
                        epoch = float(d["epoch"])
                        b = float(d["bytes_raw"]) * _BYTES_PER_UNIT.get(d.get("kind", "ib"), 1)
                    except (KeyError, ValueError):
                        continue
                    key = (d.get("device", "?"), d.get("port", "?"), d.get("direction", "?"))
                    cur = latest_by_key.get(key)
                    if cur is None or epoch > cur[0]:
                        latest_by_key[key] = (epoch, b)
        except OSError:
            return
        updated = {}
        for key, (epoch, b) in latest_by_key.items():
            prev = self._prev_links.get(key)
            if prev is not None:
                prev_epoch, prev_b = prev
                dt = epoch - prev_epoch
                delta = b - prev_b
                if dt > 0 and delta >= 0:
                    updated[key] = (delta * 8) / 1e9 / dt
            self._prev_links[key] = (epoch, b)
        if updated:
            with self.lock:
                self.link_gbps.update(updated)

    def poll_crypto(self):
        # No perf on PATH (or not permitted) - stay silent rather than
        # spamming every tick; other pollers keep working.
        if not self._perf_path:
            if not self._perf_warned:
                print("benchprof-exporter: perf not found - encryption CPU "
                      "metrics disabled", file=sys.stderr)
                self._perf_warned = True
            return

        fd, data_path = tempfile.mkstemp(prefix=f"benchprof-crypto-{self.host}-", suffix=".data")
        os.close(fd)
        try:
            rec = subprocess.run(
                [self._perf_path, "record", "-e", "cpu-clock", "-F", "99",
                 "-a", "-g", "-o", data_path, "--", "sleep", str(CRYPTO_SAMPLE_S)],
                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
            )
            if rec.returncode != 0:
                return
            script = subprocess.run(
                [self._perf_path, "script", "-i", data_path,
                 "-F", "comm,ip,sym,dso"],
                stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True,
            )
        finally:
            try:
                os.remove(data_path)
            except OSError:
                pass

        total = 0
        counts = {"ssk": 0, "fscrypt": 0}
        cur_command = ""
        cur_is_crypto_kind = None
        for line in script.stdout.splitlines():
            if not line.strip():
                if cur_is_crypto_kind is not None:
                    counts[cur_is_crypto_kind] += 1
                if cur_command:
                    total += 1
                cur_command = ""
                cur_is_crypto_kind = None
                continue
            if not line.startswith((" ", "\t")):
                # New sample header, e.g. "elbencho 12345 [003] 123.456: cpu-clock:"
                cur_command = line.split()[0] if line.split() else ""
                continue
            if cur_is_crypto_kind is not None:
                continue  # already classified this sample
            if _SSK_SYMBOL_RE.search(line):
                cur_is_crypto_kind = "ssk"
            elif _FSCRYPT_SYMBOL_RE.search(line):
                cur_is_crypto_kind = "fscrypt"
            elif _GENERIC_CRYPTO_RE.search(line):
                cur_is_crypto_kind = "ssk" if _is_lustre_proc(cur_command) else "fscrypt"
        # Flush a trailing block with no final blank line.
        if cur_command:
            total += 1
            if cur_is_crypto_kind is not None:
                counts[cur_is_crypto_kind] += 1

        if total > 0:
            with self.lock:
                self.crypto_pct = {k: 100.0 * v / total for k, v in counts.items()}

    def poll_once(self):
        # Each poll_X() is wrapped individually (not just here) so one
        # bad tick on one source (e.g. a truncated pidstat/links line read
        # mid-write) can't raise out of poll_once(), kill the daemon poller
        # thread for good, and silently freeze /metrics for the rest of the
        # run while the other sources keep working fine.
        for fn in (self.poll_cpu, self.poll_mem, self.poll_pidstat, self.poll_links):
            try:
                fn()
            except Exception:
                pass

    def render(self) -> str:
        with self.lock:
            cpu_pct = dict(self.cpu_pct)
            mem_pct = self.mem_pct
            process_cpu = dict(self.process_cpu)
            link_gbps = dict(self.link_gbps)
            crypto_pct = dict(self.crypto_pct)

        lines = [
            "# HELP benchprof_cpu_percent Live system CPU time breakdown (/proc/stat)",
            "# TYPE benchprof_cpu_percent gauge",
        ]
        for mode, pct in sorted(cpu_pct.items()):
            lines.append(f'benchprof_cpu_percent{{node="{self.host}",mode="{mode}"}} {pct:.3f}')

        if mem_pct is not None:
            lines += [
                "# HELP benchprof_mem_percent Live memory used percent (/proc/meminfo)",
                "# TYPE benchprof_mem_percent gauge",
                f'benchprof_mem_percent{{node="{self.host}"}} {mem_pct:.3f}',
            ]

        lines += [
            "# HELP benchprof_process_cpu_percent Live per-process %CPU (pidstat)",
            "# TYPE benchprof_process_cpu_percent gauge",
        ]
        for command, pct in sorted(process_cpu.items()):
            safe = command.replace('"', "'")
            lines.append(f'benchprof_process_cpu_percent{{node="{self.host}",command="{safe}"}} {pct:.3f}')

        lines += [
            "# HELP benchprof_net_link_gbps Live IB/RoCE link throughput",
            "# TYPE benchprof_net_link_gbps gauge",
        ]
        for (device, port, direction), gbps in sorted(link_gbps.items()):
            lines.append(
                f'benchprof_net_link_gbps{{node="{self.host}",device="{device}",port="{port}",'
                f'direction="{direction}"}} {gbps:.6f}'
            )
        if crypto_pct:
            lines += [
                "# HELP benchprof_crypto_cpu_percent Live estimated CPU%% "
                "spent in encryption (SSK/fscrypt), from perf sample "
                "classification",
                "# TYPE benchprof_crypto_cpu_percent gauge",
            ]
            for kind, pct in sorted(crypto_pct.items()):
                lines.append(
                    f'benchprof_crypto_cpu_percent{{node="{self.host}",kind="{kind}"}} {pct:.3f}'
                )
        return "\n".join(lines) + "\n"


def _poll_loop(collector: Collector, stop_event: threading.Event):
    while not stop_event.is_set():
        collector.poll_once()
        stop_event.wait(POLL_S)


def _crypto_poll_loop(collector: Collector, stop_event: threading.Event):
    while not stop_event.is_set():
        try:
            collector.poll_crypto()
        except Exception:
            pass
        # poll_crypto() itself blocks for ~CRYPTO_SAMPLE_S seconds (that's
        # the perf recording window), so only wait out the remainder of the
        # tick rather than the full interval on top of that.
        stop_event.wait(max(0.0, CRYPTO_POLL_S - CRYPTO_SAMPLE_S))


def _make_handler(collector: Collector):
    class Handler(http.server.BaseHTTPRequestHandler):
        def do_GET(self):
            if self.path.rstrip("/") in ("", "/metrics"):
                body = collector.render().encode("utf-8")
                self.send_response(200)
                self.send_header("Content-Type", "text/plain; version=0.0.4")
                self.send_header("Content-Length", str(len(body)))
                self.end_headers()
                self.wfile.write(body)
            elif self.path == "/healthz":
                self.send_response(200)
                self.end_headers()
                self.wfile.write(b"ok")
            else:
                self.send_response(404)
                self.end_headers()

        def log_message(self, fmt, *args):
            pass  # keep stdout/stderr clean

    return Handler


def main() -> int:
    ap = argparse.ArgumentParser()
    ap.add_argument("--rundir", required=True)
    ap.add_argument("--host", required=True)
    ap.add_argument("--port", type=int, required=True)
    args = ap.parse_args()

    collector = Collector(args.host, Path(args.rundir))
    stop_event = threading.Event()
    poller = threading.Thread(target=_poll_loop, args=(collector, stop_event), daemon=True)
    poller.start()
    crypto_poller = threading.Thread(
        target=_crypto_poll_loop, args=(collector, stop_event), daemon=True
    )
    crypto_poller.start()

    # allow_reuse_address must be a class attribute set before construction
    # (ThreadingTCPServer.__init__ binds immediately) - setting the instance
    # attribute afterwards is too late to affect SO_REUSEADDR, so a socket
    # left in TIME_WAIT by a prior crashed/killed agent run would make this
    # bind fail with "Address already in use".
    class _ReusableServer(socketserver.ThreadingTCPServer):
        allow_reuse_address = True

    server = _ReusableServer(("0.0.0.0", args.port), _make_handler(collector))
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        pass
    finally:
        stop_event.set()
        server.shutdown()
    return 0


if __name__ == "__main__":
    sys.exit(main())
